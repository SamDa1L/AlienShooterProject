# Local temporary test scripts/tools, do not upload to Git
/[Aa]ssets/TmpTests/
/[Aa]ssets/TmpTests.meta

# Unity template tutorial/readme leftovers
/.vsconfig
/[Aa]ssets/TutorialInfo/
/[Aa]ssets/TutorialInfo.meta
/[Aa]ssets/Readme.asset
/[Aa]ssets/Readme.asset.meta
/[Aa]ssets/[Ss]cenes/SampleScene.unity
/[Aa]ssets/[Ss]cenes/SampleScene.unity.meta

# Top Down Demo 所需的嵌入式后处理包
/[Pp]ackages/com.unity.postprocessing/*
!/[Pp]ackages/com.unity.postprocessing/
!/[Pp]ackages/com.unity.postprocessing/**
!/[Pp]ackages/com.unity.postprocessing.meta
